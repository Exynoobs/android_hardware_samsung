android_app {
    name: "TouchProtection",
    defaults: ["SettingsLibDefaults"],

    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],

    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,

    optimize: {
        optimize: true,
        shrink_resources: true,
    },
}
